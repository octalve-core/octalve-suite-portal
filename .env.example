# App
NEXT_PUBLIC_APP_URL=http://localhost:3003
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3003

# Google OAuth (get from https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# PostgreSQL recommended for production
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/octalve_workspace?schema=public"

# Manual bank details shown to clients
OCTALVE_BANK_NAME="Your Bank Name"
OCTALVE_ACCOUNT_NAME="Octalve"
OCTALVE_ACCOUNT_NUMBER="0000000000"

# Payment gateway settings - server only
# Do not prefix gateway secrets with NEXT_PUBLIC_.
PAYSTACK_PUBLIC_KEY=""
PAYSTACK_SECRET_KEY=""
PAYSTACK_WEBHOOK_SECRET=""

FLUTTERWAVE_PUBLIC_KEY=""
FLUTTERWAVE_SECRET_KEY=""
FLUTTERWAVE_WEBHOOK_SECRET=""

PAYMENT_CALLBACK_BASE_URL="https://workspace.octalve.com"
# PayPal - future support, server-side OAuth flow
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""