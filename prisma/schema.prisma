generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // URL configured in prisma.config.ts (Prisma 7+ requirement)
}

enum Role {
  CLIENT
  STAFF
  PROJECT_MANAGER
  SUPER_ADMIN
}

// Title Case to match frontend type: "Launch" | "Impact" | "Growth" | "Partner" | "Custom"
enum PackageType {
  Launch
  Impact
  Growth
  Partner
  WebsiteStarter
  WebsiteProBiz
  WebsiteAdvance
  BrandingStarter
  BrandingProBiz
  BrandingAdvance
  LeapRegistration
  Custom
}

enum ProjectStatus {
  PENDING_REVIEW
  APPROVED_AWAITING_DEPOSIT
  DEPOSIT_PENDING_CONFIRMATION
  ACTIVE
  AWAITING_BALANCE
  BALANCE_PENDING_CONFIRMATION
  COMPLETED
  REJECTED
}

enum PhaseStatus {
  LOCKED
  NOT_STARTED
  IN_PROGRESS
  AWAITING_APPROVAL
  CHANGES_REQUESTED
  APPROVED
}

enum DeliverableStatus {
  DRAFT
  READY_FOR_REVIEW
  NEEDS_CHANGES
  APPROVED
}

enum PaymentStatus {
  UNPAID
  PENDING_CONFIRMATION
  CONFIRMED
  REJECTED
}

enum PaymentType {
  DEPOSIT
  BALANCE
}

enum ProjectRequestStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  INFO_REQUESTED
}

enum MessageType {
  MESSAGE
  SYSTEM
}

// Better Auth core user table plus Octalve Workspace profile fields.
model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  role      Role    @default(CLIENT)
  phone     String?
  company   String?
  specialty String?

  // Better Auth admin plugin fields
  banned     Boolean   @default(false)
  banReason  String?
  banExpires DateTime?

  sessions Session[]
  accounts Account[]

  clientProjects        Project[]        @relation("ProjectClient")
  managedProjects       Project[]        @relation("ProjectManager")
  assignedPhases        ProjectPhase[]   @relation("PhaseStaff")
  projectRequests       ProjectRequest[]
  phaseMessages         PhaseMessage[]
  confirmedPayments     ProjectPayment[] @relation("PaymentConfirmer")
  reviews               Review[]
  submittedDeliverables Deliverable[]    @relation("DeliverableSubmitter")
  notifications         Notification[]
  walletLedgerEntries  WalletLedgerEntry[]
  walletTopUps         WalletTopUp[]
}

model Session {
  id             String   @id @default(cuid())
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Better Auth admin plugin field for impersonation tracking
  impersonatedBy String?
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model ProjectTemplate {
  id          String          @id @default(cuid())
  name        String
  packageType PackageType     @default(Custom)

  // Dynamic display/configuration fields.
  // These make templates database-managed instead of catalog-dependent.
  slug        String?
  category    String          @default("Custom")
  color       String          @default("#5300D9")
  iconKey     String          @default("layers")
  sortOrder   Int             @default(0)
  isOfficial  Boolean         @default(false)

  description String
  isActive    Boolean         @default(true)
  phases      TemplatePhase[]
  requests    ProjectRequest[]
  projects    Project[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model TemplatePhase {
  id           String              @id @default(cuid())
  templateId   String
  template     ProjectTemplate     @relation(fields: [templateId], references: [id], onDelete: Cascade)
  order        Int
  title        String
  description  String?
  deliverables TemplateDeliverable[]
}

model TemplateDeliverable {
  id              String        @id @default(cuid())
  templatePhaseId String
  templatePhase   TemplatePhase @relation(fields: [templatePhaseId], references: [id], onDelete: Cascade)
  name            String
  order           Int
}

model ProjectRequest {
  id                  String               @id @default(cuid())
  clientId            String
  client              User                 @relation(fields: [clientId], references: [id], onDelete: Cascade)
  templateId          String?
  template            ProjectTemplate?      @relation(fields: [templateId], references: [id], onDelete: SetNull)
  packageType         PackageType
  projectName         String
  businessName        String
  phone               String?
  projectGoal         String
  projectDescription  String
  preferredTimeline   String?
  additionalNotes     String?
  status              ProjectRequestStatus @default(PENDING_REVIEW)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  // Back-relation: the project created when this request was approved
  project             Project?

  @@index([clientId])
  @@index([templateId])
  @@index([status])
}

model Project {
  id                String           @id @default(cuid())
  clientId          String
  client            User             @relation("ProjectClient", fields: [clientId], references: [id], onDelete: Cascade)
  templateId        String?
  template          ProjectTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  title             String
  businessName      String
  clientEmail       String           // Snapshot of client email at project creation time
  packageType       PackageType
  status            ProjectStatus    @default(APPROVED_AWAITING_DEPOSIT)
  targetDate        DateTime?
  projectCode       String           @unique
  projectManagerId  String?
  projectManager    User?            @relation("ProjectManager", fields: [projectManagerId], references: [id], onDelete: SetNull)
  totalAmount       Int              @default(0)
  depositAmount     Int              @default(0)
  balanceAmount     Int              @default(0)
  depositPercentage Int              @default(70)
  internalNotes     String?
  clientBrief       String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  // Link back to the request that spawned this project (null for admin-created projects)
  requestId         String?          @unique
  request           ProjectRequest?  @relation(fields: [requestId], references: [id], onDelete: SetNull)

  phases              ProjectPhase[]
  payments            ProjectPayment[]
  paymentTransactions PaymentTransaction[]
  walletLedgerEntries WalletLedgerEntry[]
  reviews             Review[]

  @@index([clientId])
  @@index([templateId])
  @@index([projectManagerId])
  @@index([status])
}

model ProjectPhase {
  id                  String      @id @default(cuid())
  projectId           String
  project             Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phaseNumber         Int
  title               String
  description         String?
  status              PhaseStatus @default(LOCKED)
  assignedStaffId     String?
  assignedStaff       User?       @relation("PhaseStaff", fields: [assignedStaffId], references: [id], onDelete: SetNull)
  approvalRequestedAt DateTime?
  approvedAt          DateTime?
  changeRequest       String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  deliverables Deliverable[]
  messages     PhaseMessage[]

  @@index([projectId])
  @@index([assignedStaffId])
}

model Deliverable {
  id              String            @id @default(cuid())
  phaseId         String
  phase           ProjectPhase      @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  link            String?
  linkType        String?
  status          DeliverableStatus @default(DRAFT)
  visibleToClient Boolean           @default(false)
  submittedById   String?
  submittedBy     User?             @relation("DeliverableSubmitter", fields: [submittedById], references: [id], onDelete: SetNull)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([phaseId])
}

model PhaseMessage {
  id          String       @id @default(cuid())
  phaseId     String
  phase       ProjectPhase @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  senderId    String?
  sender      User?        @relation(fields: [senderId], references: [id], onDelete: SetNull)
  senderName  String
  // Accepted values: CLIENT, STAFF, PROJECT_MANAGER, SUPER_ADMIN, SYSTEM
  senderRole  String
  message     String
  type        MessageType  @default(MESSAGE)
  createdAt   DateTime     @default(now())

  @@index([phaseId])
}

model ProjectPayment {
  id                  String        @id @default(cuid())
  projectId           String
  project             Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type                PaymentType
  amount              Int
  status              PaymentStatus @default(UNPAID)
  reference           String        @unique
  bankName            String
  accountName         String
  accountNumber       String
  clientMarkedPaidAt  DateTime?
  confirmedById       String?
  confirmedBy         User?         @relation("PaymentConfirmer", fields: [confirmedById], references: [id], onDelete: SetNull)
  confirmedAt         DateTime?
  note                String?

  // Provider/payment automation fields. Provider remains String so future gateways do not force enum churn.
  provider            String        @default("MANUAL_BANK")
  gatewayReference    String?
  providerReference   String?
  paidVia             String?
  confirmedSource     String?

  transactions        PaymentTransaction[]
  walletLedgerEntries WalletLedgerEntry[]

  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([projectId])
  @@index([provider])
  @@index([gatewayReference])
  @@index([status, type])
}



model PaymentBankSetting {
  id            String   @id @default("official")
  bankName      String
  accountName   String
  accountNumber String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model PaymentGatewaySetting {
  id                   String   @id @default(cuid())

  // Uses TypeScript as-const provider constants, not Prisma enum, for future gateway expansion.
  provider             String   @unique
  displayName          String
  isEnabled            Boolean  @default(false)
  mode                 String   @default("LIVE")
  sortOrder            Int      @default(0)

  // Store environment variable names only. Do not store secret values in the database.
  publicKeyEnvName     String?
  secretKeyEnvName     String?
  webhookSecretEnvName String?

  callbackPath         String?
  webhookPath          String?
  notes                String?

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([provider, isEnabled])
}

model PaymentTransaction {
  id                  String               @id @default(cuid())
  paymentId           String
  payment             ProjectPayment       @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  projectId           String
  project             Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)

  webhookEventId      String?
  webhookEvent        PaymentWebhookEvent? @relation(fields: [webhookEventId], references: [id], onDelete: SetNull)

  provider            String
  status              String               @default("INITIALIZED")
  amount              Int
  currency            String               @default("NGN")

  // Internal idempotency/reference control.
  reference           String               @unique
  idempotencyKey      String               @unique

  // Provider-side references. These are not trusted unless verified server-side.
  providerReference   String?              @unique
  providerStatus      String?
  authorizationUrl    String?

  initiatedById       String?
  verifiedAt          DateTime?
  confirmedAt         DateTime?
  failedAt            DateTime?
  failureReason       String?

  walletLedgerEntries WalletLedgerEntry[]

  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([paymentId])
  @@index([projectId])
  @@index([provider, status])
  @@index([createdAt])
}

model PaymentWebhookEvent {
  id              String   @id @default(cuid())

  provider        String
  eventType       String
  eventId         String?
  reference       String?
  status          String   @default("RECEIVED")

  // Security/idempotency controls.
  signatureValid  Boolean  @default(false)
  payloadHash     String?
  idempotencyKey  String   @unique

  processedAt     DateTime?
  processingError String?

  transactions    PaymentTransaction[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([provider, eventId])
  @@index([provider, eventType])
  @@index([reference])
  @@index([status])
}


model WalletTopUp {
  id                  String              @id @default(cuid())

  userId              String
  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  provider            String
  status              String              @default("INITIALIZED")
  amount              Int
  currency            String              @default("NGN")

  // Internal idempotency/reference control.
  reference           String              @unique
  idempotencyKey      String              @unique

  // Provider-side references. These are not trusted unless verified server-side.
  providerReference   String?             @unique
  providerStatus      String?
  authorizationUrl    String?

  initiatedById       String?
  verifiedAt          DateTime?
  confirmedAt         DateTime?
  failedAt            DateTime?
  failureReason       String?

  walletLedgerEntries WalletLedgerEntry[]

  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([userId])
  @@index([provider, status])
  @@index([createdAt])
}

model WalletLedgerEntry {
  id            String              @id @default(cuid())

  userId        String
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  projectId     String?
  project       Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)

  paymentId     String?
  payment       ProjectPayment?     @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  transactionId String?
  transaction   PaymentTransaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  topUpId       String?
  topUp         WalletTopUp?        @relation(fields: [topUpId], references: [id], onDelete: SetNull)

  entryType     String
  direction     String
  amount        Int
  currency      String              @default("NGN")
  balanceAfter  Int?

  reference     String              @unique
  description   String?
  metadata      Json?

  createdAt     DateTime            @default(now())

  @@index([userId])
  @@index([projectId])
  @@index([paymentId])
  @@index([transactionId])
  @@index([topUpId])
  @@index([entryType])
  @@index([createdAt])
}

model Review {
  id                  String   @id @default(cuid())
  projectId           String
  project             Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  clientId            String
  client              User     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  rating              Int
  comment             String
  permissionToPublish Boolean  @default(false)
  createdAt           DateTime @default(now())

  // One review per client per project
  @@unique([projectId, clientId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role?
  title     String
  body      String
  href      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([role])
}

model SupportSetting {
  id                       String   @id @default("official")
  supportEmail             String   @default("info@octalve.com")
  guideUrl                 String   @default("https://octalve.com/trends")
  preferPhaseThreadSupport Boolean  @default(true)
  paymentDisputeSafetyText String   @default("For payment disputes, include the payment reference only. Do not send card details, OTPs, passwords, private keys, or admin credentials.")
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

model WorkspaceDefaultSetting {
  id                            String   @id @default("official")
  defaultTimezone               String   @default("Africa/Lagos")
  defaultLanguage               String   @default("English (US)")
  updateFrequency               String   @default("WEEKLY_DIGEST")
  emailDigest                   String   @default("SUMMARY_OF_ALL_ACTIVITY")
  allowClientPreferenceOverride Boolean  @default(false)
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt
}

model NotificationDefaultSetting {
  id                            String   @id @default("official")
  inAppAlertsEnabled             Boolean  @default(true)
  emailAlertsEnabled             Boolean  @default(false)
  paymentUpdatesEnabled          Boolean  @default(true)
  approvalNotificationsEnabled   Boolean  @default(true)
  projectUpdatesEnabled          Boolean  @default(true)
  supportMessagesEnabled         Boolean  @default(false)
  emailProvider                  String   @default("NONE")
  createdAt                      DateTime @default(now())
  updatedAt                      DateTime @updatedAt
}

model EmailTemplate {
  id        String   @id @default(cuid())
  eventKey  String   @unique
  title     String
  subject   String
  body      String
  channel   String   @default("EMAIL")
  isEnabled Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([channel, isEnabled])
}
